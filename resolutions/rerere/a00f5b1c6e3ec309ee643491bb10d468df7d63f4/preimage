          </StatusRowMetaLine>
          <StatusRowTitleLine
            workspace={workspace}
            primaryLabel={primaryLabel}
            editable={workspaceTitleSource === "title" && Boolean(onSubmitRename)}
            onSubmitRename={onSubmitRename}
          />
        </View>
      </View>
      <StatusRowDetailLine
        secondaryLabel={secondaryLabel}
        diffStat={workspace.diffStat}
        prHint={workspace.prHint}
        hostBadge={hostBadge}
        serviceSummary={serviceSummary}
        providers={workspace.providers}
      />
      {showShortcut && shortcutNumber !== null ? (
        <View style={styles.shortcutBadgeOverlay} pointerEvents="none">
          <SidebarWorkspaceShortcutBadge number={shortcutNumber} />
        </View>
      ) : null}
    </View>
  );
});

function StatusRowMetaLine({
  repoSlug,
  isArchiving,
  activityLabel,
  showTimestamp,
  showTrailingActions,
  children,
}: {
  repoSlug: string;
  isArchiving: boolean;
  activityLabel: string | null;
  showTimestamp: boolean;
  showTrailingActions: boolean;
  children?: ReactNode;
}) {
  // The quick actions sit in flow, not in an absolute overlay: they claim real
  // width so the slug truncates with an ellipsis instead of being painted over.
  // Row height stays fixed via the meta line's pinned minHeight.
  return (
    <View style={styles.metaRow}>
      <Text style={styles.repoSlug} numberOfLines={1}>
        {repoSlug}
      </Text>
      <View style={styles.metaTrailing}>
        {showTimestamp ? (
          <StatusRowTimestamp isArchiving={isArchiving} activityLabel={activityLabel} />
        ) : null}
        {showTrailingActions ? children : null}
      </View>
    </View>
  );
}

function StatusRowTitleLine({
  workspace,
  primaryLabel,
  editable,
  onSubmitRename,
}: {
  workspace: SidebarWorkspaceEntry;
  primaryLabel: string;
  editable: boolean;
  onSubmitRename?: (value: string) => Promise<void>;
}) {
  return (
    <View style={styles.titleRow}>
      <SidebarWorkspaceInlineTitle
        displayValue={primaryLabel}
        renameValue={workspace.title ?? workspace.name}
        editable={editable}
        onSubmit={onSubmitRename}
        style={styles.title}
        testID={`sidebar-workspace-title-${workspace.workspaceKey}`}
      />
    </View>
  );
}

/**
 * The card's own detail line. The branch and diff belong to this workspace alone, so they
 * lead; everything the compact row would also show — host, change request, checks, running
 * service — comes from `WorkspaceMetaRow` so both grouping modes honour the same display
 * preferences and render the same glyphs.
 */
function StatusRowDetailLine({
  secondaryLabel,
  diffStat,
  prHint,
  hostBadge,
  serviceSummary,
  providers,
}: {
  secondaryLabel: string | null;
  diffStat: SidebarWorkspaceEntry["diffStat"];
  prHint: SidebarWorkspaceEntry["prHint"];
  hostBadge: HostBadgeModel | null;
  serviceSummary: WorkspaceServiceSummary | null;
  providers: readonly string[];
}) {
  return (
    <View style={styles.detailRow}>
      <View style={styles.detailLeft}>
        {secondaryLabel ? (
          <Text style={styles.branch} numberOfLines={1}>
            {secondaryLabel}
          </Text>
        ) : null}
        {diffStat ? (
          <DiffStat additions={diffStat.additions} deletions={diffStat.deletions} />
        ) : null}
      </View>
      <View style={styles.detailRight}>
        <WorkspaceMetaRow hostBadge={hostBadge} prHint={prHint} serviceSummary={serviceSummary} />
        <StatusRowProviderIcons providers={providers} />
      </View>
    </View>
  );
}

/** One glyph per provider with a live agent, most recently active first. */
function StatusRowProviderIcons({ providers }: { providers: readonly string[] }) {
  if (providers.length === 0) {
    return null;
  }
  return (
    <View style={styles.providerIcons}>
      {providers.slice(0, MAX_PROVIDER_ICONS).map((provider) => (
        <StatusRowProviderIcon key={provider} provider={provider} />
      ))}
    </View>
  );
}

function StatusRowProviderIcon({ provider }: { provider: string }) {
  return (
    <ThemedDynamicProviderIcon
      provider={provider}
      size={PROVIDER_ICON_SIZE}
      uniProps={providerIconColorMapping}
    />
  );
}

/**
 * The branch line would repeat the title when the title source is "branch", so
 * fall back to the workspace name and drop the line entirely when both match.
 */
export function resolveStatusRowSecondaryLabel({
  workspace,
  primaryLabel,
}: {
  workspace: Pick<SidebarWorkspaceEntry, "name" | "currentBranch">;
  primaryLabel: string;
}): string | null {
  const branch = workspace.currentBranch;
  if (branch && branch !== primaryLabel) {
    return branch;
  }
  return workspace.name === primaryLabel ? null : workspace.name;
}

function StatusRowTimestamp({
  isArchiving,
  activityLabel,
}: {
  isArchiving: boolean;
  activityLabel: string | null;
}) {
  if (isArchiving) {
    return <ThemedLoadingSpinner size={10} uniProps={foregroundMutedColorMapping} />;
  }
  if (!activityLabel) {
    return null;
  }
  return <Text style={styles.timestamp}>{activityLabel}</Text>;
}

function StatusRowLeadingVisual({
  workspace,
  iconDataUri,
}: {
  workspace: SidebarWorkspaceEntry;
  iconDataUri: string | null;
}) {
  const dotColorStyle = getStatusDotColorStyle(workspace.statusBucket);
  const showRunningIndicator = shouldRenderSyncedStatusLoader({
    bucket: workspace.statusBucket,
  });

  return (
    <View
      style={styles.leadingVisualSlot}
      testID={`sidebar-row-project-icon-${workspace.workspaceKey}`}
    >
      <ProjectIconView
        iconDataUri={iconDataUri}
        initial={workspace.projectName.charAt(0).toUpperCase()}
        projectViewKey={workspace.projectViewKey}
        size={PROJECT_ICON_SIZE}
        textStyle={styles.projectIconFallbackText}
      />
      {showRunningIndicator ? (
        <View style={styles.statusLoaderOverlay} testID="workspace-status-indicator-running">
          <ThemedSyncedLoader size={11} uniProps={syncedLoaderColorMapping} />
        </View>
      ) : null}
      {dotColorStyle ? <View style={[styles.statusDotOverlay, dotColorStyle]} /> : null}
    </View>
  );
}

/** Inline archive affordance revealed next to the kebab on hover (web only). */
export function SidebarStatusRowArchiveAction({
  label,
  onArchive,
}: {
  label: string;
  onArchive: () => void;
}) {
  const [isHovered, setIsHovered] = useState(false);
  const handleHoverIn = useCallback(() => setIsHovered(true), []);
  const handleHoverOut = useCallback(() => setIsHovered(false), []);
  const handlePressIn = useCallback((event: GestureResponderEvent) => event.stopPropagation(), []);
  const handlePress = useCallback(
    (event: GestureResponderEvent) => {
      event.stopPropagation();
      onArchive();
    },
    [onArchive],
  );
  const textStyle = useMemo(
    () =>
      isHovered
        ? [styles.archiveActionText, styles.archiveActionTextHovered]
        : styles.archiveActionText,
    [isHovered],
  );

  return (
    <Pressable
      // The row itself is a <button> on web; a nested button is invalid HTML.
      accessibilityRole={isWeb ? undefined : "button"}
      accessibilityLabel={label}
      hitSlop={4}
      onHoverIn={handleHoverIn}
      onHoverOut={handleHoverOut}
      onPressIn={handlePressIn}
      onPress={handlePress}
      style={styles.archiveAction}
      testID="sidebar-status-row-archive-action"
    >
      <ThemedArchive
        size={ARCHIVE_ICON_SIZE}
        uniProps={isHovered ? foregroundColorMapping : foregroundMutedColorMapping}
      />
      <Text style={textStyle}>{label}</Text>
    </Pressable>
  );
}

// Same buckets and colors as the project-mode status dot; "done" carries no dot.
function getStatusDotColorStyle(bucket: SidebarStateBucket) {
  switch (bucket) {
    case "needs_input":
      return styles.statusDotNeedsInput;
    case "failed":
      return styles.statusDotFailed;
    case "running":
      return null;
    case "attention":
      return styles.statusDotAttention;
    case "done":
      return null;
  }
}

