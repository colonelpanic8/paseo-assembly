import { describe, expect, it } from "vitest";
import { QueryClient } from "@tanstack/react-query";
import {
  archivedWorkspacesQueryKey,
  beginArchivedWorkspaceTransition,
  mergeArchivedWorkspaces,
  settleArchivedWorkspaceTransition,
  shouldRefreshArchivedWorkspaces,
  type ArchivedWorkspaceEntry,
  type ArchivedWorkspaceSource,
} from "./use-archived-workspaces";

function entry(input: {
  serverId: string;
  workspaceId: string;
  archivedAt: string;
}): ArchivedWorkspaceEntry {
  return {
    workspaceKey: `${input.serverId}:${input.workspaceId}`,
    serverId: input.serverId,
    workspaceId: input.workspaceId,
    projectName: "repo",
    name: input.workspaceId,
    archivedAt: new Date(input.archivedAt),
    phase: "archived",
  };
}

function hostSlice(serverId: string, count: number): ArchivedWorkspaceEntry[] {
  const entries: ArchivedWorkspaceEntry[] = [];
  for (let index = 0; index < count; index += 1) {
    entries.push(
      entry({
        serverId,
        workspaceId: `${serverId}-${index}`,
        archivedAt: new Date(Date.UTC(2026, 2, 1, 0, index)).toISOString(),
      }),
    );
  }
  return entries;
}

describe("mergeArchivedWorkspaces", () => {
  it("interleaves hosts by archive time, newest first", () => {
    const merged = mergeArchivedWorkspaces([
      {
        isOnline: true,
        entries: [
          entry({ serverId: "a", workspaceId: "a-old", archivedAt: "2026-03-01T00:00:00.000Z" }),
          entry({ serverId: "a", workspaceId: "a-new", archivedAt: "2026-03-05T00:00:00.000Z" }),
        ],
      },
      {
        isOnline: true,
        entries: [
          entry({ serverId: "b", workspaceId: "b-mid", archivedAt: "2026-03-03T00:00:00.000Z" }),
        ],
      },
    ]);

    expect(merged.map((item) => item.workspaceId)).toEqual(["a-new", "b-mid", "a-old"]);
  });

  it("ignores hosts that have not resolved yet", () => {
    const merged = mergeArchivedWorkspaces([
      { isOnline: true, entries: undefined },
      {
        isOnline: true,
        entries: [
          entry({ serverId: "b", workspaceId: "b-one", archivedAt: "2026-03-03T00:00:00.000Z" }),
        ],
      },
      { isOnline: true, entries: undefined },
    ]);

    expect(merged.map((item) => item.workspaceId)).toEqual(["b-one"]);
  });

  it("drops cached rows as soon as their host goes offline", () => {
    const merged = mergeArchivedWorkspaces([
      {
        isOnline: false,
        entries: [
          entry({ serverId: "a", workspaceId: "stale", archivedAt: "2026-03-04T00:00:00.000Z" }),
        ],
      },
      {
        isOnline: true,
        entries: [
          entry({ serverId: "b", workspaceId: "live", archivedAt: "2026-03-03T00:00:00.000Z" }),
        ],
      },
    ]);

    expect(merged.map((item) => item.workspaceId)).toEqual(["live"]);
  });

  it("orders a cascade archive deterministically when timestamps tie", () => {
    const sameInstant = "2026-03-04T00:00:00.000Z";
    const forward = mergeArchivedWorkspaces([
      {
        isOnline: true,
        entries: [
          entry({ serverId: "a", workspaceId: "child", archivedAt: sameInstant }),
          entry({ serverId: "a", workspaceId: "parent", archivedAt: sameInstant }),
        ],
      },
    ]);
    const reversed = mergeArchivedWorkspaces([
      {
        isOnline: true,
        entries: [
          entry({ serverId: "a", workspaceId: "parent", archivedAt: sameInstant }),
          entry({ serverId: "a", workspaceId: "child", archivedAt: sameInstant }),
        ],
      },
    ]);

    expect(forward.map((item) => item.workspaceId)).toEqual(["child", "parent"]);
    expect(reversed.map((item) => item.workspaceId)).toEqual(forward.map((i) => i.workspaceId));
  });

  it("caps the merged tail so many hosts cannot grow it without bound", () => {
    const sources: ArchivedWorkspaceSource[] = ["a", "b", "c"].map((serverId) => ({
      isOnline: true,
      entries: hostSlice(serverId, 20),
    }));

    const merged = mergeArchivedWorkspaces(sources);

    expect(merged).toHaveLength(25);
    // Still the newest ones, not just the first host's slice.
    expect(new Set(merged.map((item) => item.serverId))).toEqual(new Set(["a", "b", "c"]));
  });
});

describe("archived workspace transitions", () => {
  it("adds a pending row immediately and settles it after the archive succeeds", async () => {
    const queryClient = new QueryClient();
    const pendingEntry = {
      ...entry({
        serverId: "a",
        workspaceId: "workspace",
        archivedAt: "2026-03-04T00:00:00.000Z",
      }),
      phase: "archiving" as const,
    };

    await beginArchivedWorkspaceTransition({ queryClient, entry: pendingEntry });
    expect(
      queryClient.getQueryData<ArchivedWorkspaceEntry[]>(archivedWorkspacesQueryKey("a")),
    ).toEqual([pendingEntry]);

    settleArchivedWorkspaceTransition({
      queryClient,
      serverId: "a",
      workspaceKey: pendingEntry.workspaceKey,
      outcome: "archived",
    });
    expect(
      queryClient.getQueryData<ArchivedWorkspaceEntry[]>(archivedWorkspacesQueryKey("a"))?.[0]
        ?.phase,
    ).toBe("archived");
  });

  it("keeps the pending row when an older archived-list request is still in flight", async () => {
    const queryClient = new QueryClient();
    const queryKey = archivedWorkspacesQueryKey("a");
    const staleEntry = entry({
      serverId: "a",
      workspaceId: "stale",
      archivedAt: "2026-03-03T00:00:00.000Z",
    });
    const pendingEntry = {
      ...entry({
        serverId: "a",
        workspaceId: "workspace",
        archivedAt: "2026-03-04T00:00:00.000Z",
      }),
      phase: "archiving" as const,
    };
    let markFetchStarted: (() => void) | undefined;
    const fetchStarted = new Promise<void>((resolve) => {
      markFetchStarted = resolve;
    });
    let resolveFetch: ((entries: ArchivedWorkspaceEntry[]) => void) | undefined;
    const inFlightFetch = queryClient
      .fetchQuery({
        queryKey,
        queryFn: () =>
          new Promise<ArchivedWorkspaceEntry[]>((resolve) => {
            markFetchStarted?.();
            resolveFetch = resolve;
          }),
      })
      .catch(() => []);

    await fetchStarted;
    await beginArchivedWorkspaceTransition({ queryClient, entry: pendingEntry });
    resolveFetch?.([staleEntry]);
    await inFlightFetch;

    expect(queryClient.getQueryData<ArchivedWorkspaceEntry[]>(queryKey)).toEqual([pendingEntry]);
  });

  it("removes only the failed pending row when archives overlap", async () => {
    const queryClient = new QueryClient();
    const first = {
      ...entry({ serverId: "a", workspaceId: "first", archivedAt: "2026-03-04T00:00:00.000Z" }),
      phase: "archiving" as const,
    };
    const second = {
      ...entry({ serverId: "a", workspaceId: "second", archivedAt: "2026-03-05T00:00:00.000Z" }),
      phase: "archiving" as const,
    };
    await beginArchivedWorkspaceTransition({ queryClient, entry: first });
    await beginArchivedWorkspaceTransition({ queryClient, entry: second });

    settleArchivedWorkspaceTransition({
      queryClient,
      serverId: "a",
      workspaceKey: first.workspaceKey,
      outcome: "failed",
    });

    expect(
      queryClient
        .getQueryData<ArchivedWorkspaceEntry[]>(archivedWorkspacesQueryKey("a"))
        ?.map((item) => item.workspaceKey),
    ).toEqual([second.workspaceKey]);
  });
});

