        : {}),
      ...(options?.disabledPromptComponents?.length
        ? { disabledPromptComponents: options.disabledPromptComponents }
        : {}),
      ...(options?.customVoiceInstructions
        ? { customVoiceInstructions: options.customVoiceInstructions }
        : {}),
