            repoSlug={repoSlug}
            isArchiving={isArchiving}
            timeAgo={timeAgo}
            showTimestamp={!showOverlayActions && !showShortcut}
            showOverlayActions={showOverlayActions}
            showInlineActions={showInlineActions}
