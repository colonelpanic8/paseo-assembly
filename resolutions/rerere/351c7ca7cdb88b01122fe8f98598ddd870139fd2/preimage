function StatusRowMetaLine({
  repoSlug,
  isArchiving,
  timeAgo,
  showTimestamp,
  showOverlayActions,
  showInlineActions,
  children,
}: {
  repoSlug: string;
  isArchiving: boolean;
  timeAgo: string | null;
  showTimestamp: boolean;
  showOverlayActions: boolean;
  showInlineActions: boolean;
  children?: ReactNode;
}) {
  // The quick actions sit in flow, not in an absolute overlay: they claim real
  // width so the slug truncates with an ellipsis instead of being painted over.
  // Row height stays fixed via the meta line's pinned minHeight.
  return (
    <View style={styles.metaRow}>
      <Text style={styles.repoSlug} numberOfLines={1}>
        {repoSlug}
