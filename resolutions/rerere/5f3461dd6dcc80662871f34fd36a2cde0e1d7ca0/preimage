const HOLD_MODIFIER_KEYS = new Set(["Shift", "Control", "Alt", "Meta"]);

function isComposerFocusAction(action: string, payload: KeyboardShortcutPayload): boolean {
  return (
    action === "message-input.action" &&
    payload !== null &&
    "kind" in payload &&
    payload.kind === "focus"
  );
}

